<script src="/plugins/rayfish/js/qrcode.js"></script>
<script>
var rfURL = '/plugins/rayfish/include/exec.php';

function rfPost(data, done) {
  data.csrf_token = csrf_token;
  $.post(rfURL, data, done, 'json').fail(function(x) {
    done({error: 'request failed: ' + x.status + ' ' + x.statusText});
  });
}

function rfShow(r) {
  var text = r.error ? 'Error: ' + r.error : (r.output || '(no output)');
  if (r.timed_out) text += '\n\n[timed out]';
  $('#rf-output').text(text);
  // `ray invite` (and `ray create` for open networks) print a `ray join <code>`
  // hint; turn that code into a QR the mobile apps can scan.
  var m = !r.error && /\bray join ([1-9A-HJ-NP-Za-km-z]{20,})/.exec(r.output || '');
  if (m) rfQr(m[1]);
  rfStatus();
}

/* rayfish://join/<code> works both in the apps' own scanners and from the
 * phone camera, which hands the link to the installed app. */
function rfQr(code) {
  var qr = qrcode(0, 'M');
  qr.addData('rayfish://join/' + code);
  qr.make();
  $('#rf-qr-img').html(qr.createSvgTag({cellSize: 4, margin: 16, scalable: true}));
  $('#rf-qr-code').text(code);
  $('#rf-qr').css('display', 'flex');
}

function rfCopy(text) {
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text);
  } else {
    var t = $('<textarea>').val(text).appendTo('body').select();
    document.execCommand('copy');
    t.remove();
  }
}

function rfBusy(msg) { $('#rf-output').text(msg + '…'); }

function rfStatus() {
  rfPost({action: 'status'}, function(r) {
    $('#rf-state').text(r.running ? 'Running' : 'Stopped')
      .toggleClass('rf-up', !!r.running).toggleClass('rf-down', !r.running);
    $('#rf-version').text(r.version || '');
    $('#rf-status').text(r.error ? 'Error: ' + r.error
      : r.running ? (r.status || '(no networks yet)')
      : 'The daemon is not running.' + (r.lastlog ? '\n\nLast daemon output:\n' + r.lastlog : ''));
    $('#rf-warn').text(r.warning || '').toggle(!!r.warning);
  });
}

function rfService(op) {
  rfBusy(op.charAt(0).toUpperCase() + op.slice(1) + 'ing the daemon');
  rfPost({action: 'service', op: op}, rfShow);
}

function rfCreate() {
  var name = $('#rf-create-name').val().trim();
  rfBusy('Creating network');
  rfPost({action: 'create', name: name,
          hostname: $('#rf-create-host').val().trim(),
          open: $('#rf-create-open').is(':checked')}, function(r) {
    // Ready for the next step: minting an invite for the new network.
    if (!r.error && r.status === 0 && name) $('#rf-invite-net').val(name);
    rfShow(r);
  });
}

function rfInvite() {
  rfBusy('Minting invite');
  rfPost({action: 'invite', network: $('#rf-invite-net').val().trim(),
          reusable: $('#rf-invite-reusable').is(':checked')}, rfShow);
}

function rfJoin() {
  rfBusy('Joining');
  rfPost({action: 'join', code: $('#rf-join-code').val(),
          hostname: $('#rf-join-host').val().trim()}, rfShow);
}

function rfRun() {
  var args = $('#rf-cmd').val();
  rfBusy('ray ' + args);
  rfPost({action: 'run', args: args}, rfShow);
}

function rfLogs() {
  $('#rf-logs').show().text('Loading…');
  rfPost({action: 'logs'}, function(r) {
    if (r.error) return $('#rf-logs').text('Error: ' + r.error);
    $('#rf-logs').text((r.logs || '(daemon not running or no logs in the last hour)') +
      (r.stdout ? '\n\n--- daemon stdout/stderr ---\n' + r.stdout : ''));
  });
}

$(function() {
  $('#rf-cmd').on('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); rfRun(); } });
  rfStatus();
  setInterval(rfStatus, 15000);
});
</script>
